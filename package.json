{
  "name": "jp-learn",
  "version": "1.0.0",
  "description": "日语学习工具（终端 + Web）— 强制打字产出 + FSRS 间隔重复 + 听力练习",
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test tests/kana.test.ts",
