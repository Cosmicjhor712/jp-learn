    "react": "^19.2.7",
    "react-dom": "^19.2.8",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.0.1",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^8.2.0"
  }
}
